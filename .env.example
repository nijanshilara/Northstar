# ══════════════════════════════════════════════════════
# AI TRAVEL GUIDE — Environment Variables
# Copy this file to backend/.env and fill in values.
# Never commit the real .env file to version control.
# ══════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./travel_guide.db
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=true

# ── AI / LLM (Phase 4) ────────────────────────────────
# Set at least ONE of these to enable real AI responses.
# Without either key the app runs in fallback mode (non-AI responses, clearly labelled).
#
# Option A — Gemini 1.5 Flash (recommended: free tier available)
#   Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
#
# Option B — OpenAI GPT-4o-mini (fallback if Gemini key absent)
#   Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Weather ───────────────────────────────────────────
# Open-Meteo is FREE and requires NO key.  The app uses it automatically.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Flights (Amadeus) ─────────────────────────────────
# Free test credentials: https://developers.amadeus.com (Self-Service)
# Test environment: https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ── Maps & Routing ────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# ── Places ────────────────────────────────────────────
FOURSQUARE_API_KEY=

# ── Currency ──────────────────────────────────────────
EXCHANGE_RATE_API_KEY=   # exchangerate-api.com — free tier available

# ── CORS ──────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Email / SMTP (Phase 3 — optional) ────────────────
# Without SMTP the app runs in "dev mode": verification tokens are printed
# to the backend console instead of being emailed.
# The VerifyEmail page shows this notice automatically.
#
# To enable real email delivery (e.g. via Mailjet SMTP):
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587       # 587 = STARTTLS (recommended)
SMTP_USER=          # your Mailjet API Key
SMTP_PASSWORD=      # your Mailjet Secret Key
SMTP_FROM=          # your verified sender email
SMTP_FROM_NAME="Northstar Travel"
