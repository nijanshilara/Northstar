# AI Travel Guide — backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./travel_guide.db

# ── Security ──────────────────────────────────────────────────────────────────
# Change to a long random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT token lifetimes ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# Leave blank to use Dev Mode: tokens are returned in the API response instead.
# For production, use Gmail SMTP, SendGrid, Mailgun, etc.
#
# Example: Gmail App Password
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=your-app-password       # from Google account > App Passwords
#   SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── AI / LLM (optional) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Weather ───────────────────────────────────────────────────────────────────
WEATHER_API_KEY=

# ── Flights — Amadeus test credentials ───────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# ── Places ────────────────────────────────────────────────────────────────────
FOURSQUARE_API_KEY=

# ── Currency ──────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
