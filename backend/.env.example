# AI Travel Guide — backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./travel_guide.db

# ── Security ──────────────────────────────────────────────────────────────────
# Change to a long random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT token lifetimes ───────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# Leave blank to use Dev Mode: tokens are returned in the API response instead.
# For production email, use Mailjet, SendGrid, Gmail SMTP, etc.
#
# Example: Mailjet SMTP
#   SMTP_HOST=in-v3.mailjet.com
#   SMTP_PORT=587
#   SMTP_USER=your_mailjet_api_key
#   SMTP_PASSWORD=your_mailjet_secret_key
#   SMTP_FROM=your_verified_sender@example.com
#   SMTP_FROM_NAME="Northstar Travel"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Northstar Travel"

# ── AI / LLM (optional) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Weather ───────────────────────────────────────────────────────────────────
WEATHER_API_KEY=

# ── Flights — Amadeus test credentials ───────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# ── Places ────────────────────────────────────────────────────────────────────
FOURSQUARE_API_KEY=

# ── Currency ──────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
